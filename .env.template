# Logging
DRY_RUN=1
DEBUG_LOG=true

# RPC
RPC_URL=

# Top-up config
# POOL_CONFIGS is a JSON array of pool configurations
# 
# APY-based pool example (existing behavior):
# {
#   "id": "pool-1",
#   "name": "My APY Pool",
#   "mode": "apy-based",
#   "stakePoolAddress": "...",
#   "privateKey": "...",
#   "targetAPY": 8,
#   "fundingPeriodMinutes": 60,
#   "isToken2022": false
# }
#
# Revenue-based pool example (new behavior for real yield):
# {
#   "id": "pool-2",
#   "name": "My Revenue Pool",
#   "mode": "revenue-based",
#   "stakePoolAddress": "...",
#   "privateKey": "...",
#   "fundingPeriodMinutes": 10080,
#   "revenueApiEndpoint": "https://api.example.com/revenue",
#   "revenueApiAuthHeader": "X-API-Key",
#   "revenueApiAuthTokenEnvVar": "REVENUE_API_TOKEN",
#   "rewardTokenMint": "So11111111111111111111111111111111111111112",  # wSOL (NATIVE_MINT)
#   "isToken2022": false,
#   "isRewardToken2022": false
# }
#
# NOTE: For wSOL (SOL) rewards, the script will automatically wrap native SOL
# to wSOL if the funding wallet has insufficient wSOL but has native SOL.
# Just deposit native SOL to the funding wallet - no manual wrapping needed.
#
POOL_CONFIGS=[{}]
PERIOD_IN_MINUTES=60

SOL_BALANCE_WARNING_THRESHOLD=5000000

# Revenue API authentication (for revenue-based pools)
# Set the token value here, reference the env var name in pool config
REVENUE_API_TOKEN=

# Notify
WEBHOOK_URL=

# Set by runner
GITHUB_WORKFLOW=
GITHUB_REPOSITORY=
GITHUB_RUN_ID=